# Locki Docker Configuration
# Copiar este archivo a .env y personalizar según necesidad

# ==========================================
# Manage Administration Service
# ==========================================

# Port for manage-administration service
ADMIN_PORT=8080

# PostgreSQL Configuration for Administration
ADMIN_DB_HOST=postgres-admin
ADMIN_DB_PORT=5432
ADMIN_DB_NAME=locki-admin
ADMIN_DB_USER=locki
ADMIN_DB_PASSWORD=locki

# Spring Boot Configuration
ADMIN_SPRING_PROFILES_ACTIVE=prod
ADMIN_LOGGING_LEVEL=INFO

# ==========================================
# Manage Reservations Service
# ==========================================

# Port for manage-reservations service
RESERVATIONS_PORT=8081

# PostgreSQL Configuration for Reservations
RESERVATIONS_DB_HOST=postgres-reservations
RESERVATIONS_DB_PORT=5432
RESERVATIONS_DB_NAME=locki-reservations
RESERVATIONS_DB_USER=locki
RESERVATIONS_DB_PASSWORD=locki

# Spring Boot Configuration
RESERVATIONS_SPRING_PROFILES_ACTIVE=prod
RESERVATIONS_LOGGING_LEVEL=INFO

# ==========================================
# PostgreSQL Shared Configuration
# ==========================================

# PostgreSQL Docker image version
POSTGRES_VERSION=15-alpine

# PostgreSQL exposed ports
POSTGRES_ADMIN_HOST_PORT=5450
POSTGRES_RESERVATIONS_HOST_PORT=5460

# ==========================================
# Docker Configuration
# ==========================================

# Docker image tag
DOCKER_IMAGE_TAG=latest

# Docker registry (leave empty for local images)
DOCKER_REGISTRY=

# Network name
DOCKER_NETWORK=locki-network

# Compose project name
COMPOSE_PROJECT_NAME=locki

